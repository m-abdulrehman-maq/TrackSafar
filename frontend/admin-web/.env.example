# Backend server URL used by the admin web app (Vite).
# Leave empty to use the dev proxy defined in vite.config.js.
VITE_API_URL=http://127.0.0.1:8000

# Optional: override the WebSocket server URL. Defaults to VITE_API_URL with ws/wss.
# VITE_WS_URL=ws://127.0.0.1:8000

# Google Maps JavaScript API key. Enable "Maps JavaScript API" and restrict the
# key by HTTP referrer in Google Cloud Console. Leave empty to show the fallback.
VITE_GOOGLE_MAPS_API_KEY=
