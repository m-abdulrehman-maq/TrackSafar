# TrackSafar backend environment configuration (sample values only — never real secrets).
# Copy to backend/.env for local development.

APP_NAME="TrackSafar API"
ENVIRONMENT=development
DEBUG=true

# Local development uses SQLite. Production requires Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://tracksafar_backend:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./tracksafar_dev.db

# Identity authority — Supabase Auth is the sole credential authority in production.
# auth_mode=development uses a local credential store and is REFUSED at startup
# when ENVIRONMENT=production.
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600

# CORS (comma separated). Wildcards are refused in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Freshness and ingestion thresholds (provisional; M4 finalizes with device evidence)
LOCATION_STALE_AFTER_SECONDS=120
LOCATION_MAX_FUTURE_SKEW_SECONDS=60
GPS_MAX_BATCH_AGE_SECONDS=300

# ETA stays disabled until the M5 method review; unavailable responses include a reason.
ETA_ENABLED=false
ETA_ASSUMED_SPEED_KMH=22
